# Copy to .env.local and fill in. Never commit .env.local.

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin/create
# Site key: public, shipped to the browser. Required for the contact form.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Secret key: server-side only, for POST /recaptcha/api/siteverify.
# Not read anywhere yet (no backend). Do not prefix this with NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=
